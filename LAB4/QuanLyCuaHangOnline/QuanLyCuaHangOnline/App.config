<?xml version="1.0" encoding="utf-8" ?>
<configuration>
  <startup><supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.7.2" /></startup>
  <connectionStrings>
    <add name="QuanLyCuaHangOnlineDB" providerName="System.Data.SqlClient"
         connectionString="Data Source=.\MSSQLSERVER01;Initial Catalog=QuanLyCuaHangOnline;Integrated Security=True;Connect Timeout=10;" />
  </connectionStrings>
  <appSettings>
    <add key="Fee_VISA" value="0" />
    <add key="Fee_Master" value="0" />
    <add key="Fee_Discover" value="0" />
    <add key="Fee_AmEx" value="0" />
  </appSettings>
</configuration>
