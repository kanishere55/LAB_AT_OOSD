@startuml
skinparam backgroundColor white
skinparam monochrome true
skinparam shadowing false
skinparam defaultFontName Times New Roman
skinparam defaultFontSize 18
skinparam dpi 180
skinparam classAttributeIconSize 0
skinparam roundcorner 0
skinparam packageStyle rectangle
skinparam classBackgroundColor white
skinparam usecaseBackgroundColor white
skinparam nodesep 75
skinparam ranksep 85
skinparam ArrowFontSize 15
skinparam sequenceMessageAlign center
skinparam responseMessageBelowArrow true
hide circle
hide empty members

control CheckoutService as C
control EmailService as S
control EmailGatewayAdapter as G
control SqlRepository as R
C -> S : Send(order) sau commit
activate S
alt không có email
S --> C : Không có email
else có email
S -> S : Body(order), loại bỏ thông tin thẻ
S -> G : Send(address, body)
alt gửi mô phỏng thành công
G --> S : thành công
S -> R : SaveEmail(..., DaGui)
else dịch vụ báo lỗi
G --> S : exception
S -> R : SaveEmail(..., LoiGui)
end
S --> C : trạng thái email
note right of C
Đơn đã lưu vẫn thành công.
Không thanh toán lại khi email lỗi.
end note
end

deactivate S
@enduml
