@startuml
skinparam backgroundColor white
skinparam monochrome true
skinparam shadowing false
skinparam defaultFontName Times New Roman
skinparam defaultFontSize 20
skinparam dpi 180
skinparam classAttributeIconSize 0
skinparam roundcorner 0
skinparam packageStyle rectangle
skinparam classBackgroundColor white
skinparam usecaseBackgroundColor white
skinparam nodesep 75
skinparam ranksep 85
skinparam ArrowFontSize 15
skinparam sequenceMessageAlign center
skinparam responseMessageBelowArrow true
hide circle
hide empty members

actor "Khách hàng" as K
boundary FrmThanhToan as F
control "Checkout\nService" as S
control "PaymentGateway\nAdapter" as P
control "SqlRepository" as R
database "SQL Server" as DB
K -> F : xác nhận thanh toán
activate F
F -> S : Place(key, recipient,\ncard, quote)
activate S
S -> R : FindOrder(key)
activate R
R --> S : đơn đã có hoặc null
deactivate R
alt yêu cầu đã hoàn tất
 S --> F : cùng DonHang
else yêu cầu mới
 S -> S : Busy = true; ValidateCard(); Quote()
 S -> S : đối chiếu báo giá đã xác nhận
 S -> P : Pay(key, card, total)
 activate P
 P --> S : PaymentResult
 deactivate P
 alt Approved = false
  S --> F : lỗi; giữ giỏ
 else Approved = true
  S -> R : SaveOrder(order)
  activate R
  R -> DB : BEGIN TRANSACTION
  activate DB
  R -> DB : INSERT DonHang, ChiTietDonHang,\nThanhToan
  alt không có lỗi SQL
   R -> DB : COMMIT
   DB --> R : MaDH
   R --> S : MaDH
   S -> S : xóa giỏ; EmailService.Send(order)
   S --> F : DonHang
  else có lỗi SQL
   R -> DB : ROLLBACK
   DB --> R : lỗi
   R --> S : lỗi lưu; giữ giỏ
  end
  deactivate DB
  deactivate R
 end
 S -> S : finally: Busy = false
end
deactivate S
F --> K : kết quả / FrmXacNhanDonHang
deactivate F

@enduml