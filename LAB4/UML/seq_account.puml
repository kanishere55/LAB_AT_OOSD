@startuml
skinparam backgroundColor white
skinparam monochrome true
skinparam shadowing false
skinparam defaultFontName Times New Roman
skinparam defaultFontSize 18
skinparam dpi 180
skinparam classAttributeIconSize 0
skinparam roundcorner 0
skinparam packageStyle rectangle
skinparam classBackgroundColor white
skinparam usecaseBackgroundColor white
skinparam nodesep 75
skinparam ranksep 85
skinparam ArrowFontSize 15
skinparam sequenceMessageAlign center
skinparam responseMessageBelowArrow true
hide circle
hide empty members

actor KhachHang as K
boundary FrmTaiKhoan as F
control AccountService as S
control SqlRepository as R
database SQLServer as D
alt đăng ký
K -> F : thông tin + mật khẩu
F -> S : Register(customer, password)
activate S
S -> S : kiểm tra, tạo salt, hash PBKDF2
S -> R : Register(customer)
R -> D : INSERT có tham số
D --> R : MaKH / lỗi trùng tên
R --> S : kết quả
S --> F : KhachHang
else đăng nhập
K -> F : username, password
F -> S : Login(username, password)
S -> R : FindCustomer(username)
R -> D : SELECT có tham số
D --> R : hash, salt, thông tin
R --> S : KhachHang
S -> S : tạo hash và so sánh
S --> F : thành công / báo lỗi
end
F -> F : cập nhật AppSession.Customer
F --> K : đóng khi thành công

deactivate S
@enduml
