@startuml
skinparam backgroundColor white
skinparam monochrome true
skinparam shadowing false
skinparam defaultFontName Times New Roman
skinparam defaultFontSize 18
skinparam dpi 180
skinparam classAttributeIconSize 0
skinparam roundcorner 0
skinparam packageStyle rectangle
skinparam classBackgroundColor white
skinparam usecaseBackgroundColor white
skinparam nodesep 75
skinparam ranksep 85
skinparam ArrowFontSize 15
skinparam sequenceMessageAlign center
skinparam responseMessageBelowArrow true
hide circle
hide empty members
left to right direction
class FrmSanPham <<boundary>> {
+LoadRows() : void
-btnTim_Click()
-btnChiTiet_Click()
-btnThem_Click()
}
class FrmChiTietSanPham <<boundary>> {
-product : SanPham
--
-LoadImage() : void
-btnThem_Click()
}
class ProductService <<control>> {
-catalog : IProductCatalog
--
+Groups()
+Search(group, keyword)
+Get(code)
}
class CartService <<control>> {
+Add(code, qty)
}
class SanPham <<entity>> {
+MaSP : string
+TenSP : string
+GiaHienHanh : decimal
+ConHang : bool
+HinhAnh : List<string>
}
class ProductCatalogAdapter <<adapter>> {
+Groups()
+Search(group, keyword)
+Get(code)
}
FrmSanPham --> ProductService
FrmChiTietSanPham --> ProductService
FrmSanPham --> CartService
FrmChiTietSanPham --> CartService
ProductService --> ProductCatalogAdapter
ProductCatalogAdapter ..> SanPham
CartService --> ProductCatalogAdapter
@enduml