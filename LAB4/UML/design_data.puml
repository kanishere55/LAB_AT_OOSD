@startuml
skinparam backgroundColor white
skinparam monochrome true
skinparam shadowing false
skinparam defaultFontName Times New Roman
skinparam defaultFontSize 18
skinparam dpi 180
skinparam classAttributeIconSize 0
skinparam roundcorner 0
skinparam packageStyle rectangle
skinparam classBackgroundColor white
skinparam usecaseBackgroundColor white
skinparam nodesep 75
skinparam ranksep 85
skinparam ArrowFontSize 15
skinparam sequenceMessageAlign center
skinparam responseMessageBelowArrow true
hide circle
hide empty members

top to bottom direction
interface IProductCatalog <<interface>> {
+Groups() : List<NhomSanPham>
+Search(group : string, keyword : string) : List<SanPham>
+Get(code : string) : SanPham
}


class ProductCatalogAdapter <<adapter>> {
-repo : SqlRepository
+Groups() : List<NhomSanPham>
+Search(group : string, keyword : string) : List<SanPham>
+Get(code : string) : SanPham
}


class SqlRepository <<data>> {
+ConnectionString : string
+Open() : SqlConnection
+Register(customer : KhachHang) : int
+FindCustomer(username : string) : KhachHang
+BaseShipping(region : string, type : string) : decimal
+SaveOrder(order : DonHang) : int
+FindOrder(key : Guid) : DonHang
+SaveEmail(id : int, address : string,
    body : string, status : string) : void

}
class Db <<data>> {
+{static} ConnectionString : string
+{static} OpenConnection() : SqlConnection
}
ProductCatalogAdapter ..|> IProductCatalog


ProductCatalogAdapter --> SqlRepository
SqlRepository ..> Db



@enduml
