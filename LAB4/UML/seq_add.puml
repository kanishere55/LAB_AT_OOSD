@startuml
skinparam backgroundColor white
skinparam monochrome true
skinparam shadowing false
skinparam defaultFontName Times New Roman
skinparam defaultFontSize 18
skinparam dpi 180
skinparam classAttributeIconSize 0
skinparam roundcorner 0
skinparam packageStyle rectangle
skinparam classBackgroundColor white
skinparam usecaseBackgroundColor white
skinparam nodesep 75
skinparam ranksep 85
skinparam ArrowFontSize 15
skinparam sequenceMessageAlign center
skinparam responseMessageBelowArrow true
hide circle
hide empty members

actor KhachHang as K
boundary "FrmSanPham /\nFrmChiTietSanPham" as F
control CartService as S
control ProductCatalogAdapter as A
entity "AppSession.Cart" as C
K -> F : thêm(MaSP, số lượng)
F -> S : Add(MaSP, qty)
activate S
S -> S : kiểm tra qty > 0 và !Busy
S -> A : Get(MaSP)
A --> S : thông tin hiện hành
alt không tồn tại hoặc hết hàng
S --> F : báo lỗi, giữ giỏ
else hợp lệ
S -> C : tìm dòng có MaSP
alt đã có
S -> C : cộng số lượng
else chưa có
S -> C : thêm CartItem
end
S --> F : thành công
F --> K : thông báo đã thêm
end

deactivate S
@enduml
