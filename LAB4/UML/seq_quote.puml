@startuml
skinparam backgroundColor white
skinparam monochrome true
skinparam shadowing false
skinparam defaultFontName Times New Roman
skinparam defaultFontSize 20
skinparam dpi 180
skinparam classAttributeIconSize 0
skinparam roundcorner 0
skinparam packageStyle rectangle
skinparam classBackgroundColor white
skinparam usecaseBackgroundColor white
skinparam nodesep 75
skinparam ranksep 85
skinparam ArrowFontSize 15
skinparam sequenceMessageAlign center
skinparam responseMessageBelowArrow true
hide circle
hide empty members

actor KhachHang as K
boundary FrmCheckout as F
control "Checkout\nService" as S
control "ProductCatalog\nAdapter" as A
control "SqlRepository" as R
K -> F : người nhận, vùng, loại giao
F -> S : Quote(recipient, "VISA")
activate S
S -> S : kiểm tra đăng nhập, giỏ, người nhận
loop mỗi dòng trong giỏ
S -> A : Get(MaSP)
A --> S : giá hiện hành, còn hàng
end
alt giá đổi / hết hàng
S --> F : yêu cầu xem lại / báo hết hàng
else dữ liệu hợp lệ
S -> R : BaseShipping(region, type)
R --> S : phí cơ bản / chưa hỗ trợ
S -> S : Shipping + Fee_card từ cấu hình
S --> F : CheckoutQuote
F --> K : tiền hàng, phí giao, tổng tạm tính
end

deactivate S
@enduml
