@startuml
skinparam backgroundColor white
skinparam monochrome true
skinparam shadowing false
skinparam defaultFontName Times New Roman
skinparam defaultFontSize 18
skinparam dpi 180
skinparam classAttributeIconSize 0
skinparam roundcorner 0
skinparam packageStyle rectangle
skinparam classBackgroundColor white
skinparam usecaseBackgroundColor white
skinparam nodesep 75
skinparam ranksep 85
skinparam ArrowFontSize 15
skinparam sequenceMessageAlign center
skinparam responseMessageBelowArrow true
hide circle
hide empty members

top to bottom direction
rectangle "FrmMain\nTrang chủ" as M
rectangle "FrmSanPham\nDanh sách, tìm kiếm" as P
rectangle "FrmGioHang\nCập nhật, xóa giỏ" as G
rectangle "FrmTaiKhoan\nĐăng ký, đăng nhập" as A
rectangle "FrmCheckout\nNgười nhận, giao hàng" as C
rectangle "FrmChiTietSanPham\nChi tiết, ảnh, thêm giỏ" as D
rectangle "FrmThanhToan\nNhập thẻ, xác nhận" as T
rectangle "FrmXacNhanDonHang\nĐơn đã ghi nhận" as X
M --> P
M --> G
M --> A : Tài khoản
M --> C : Đặt hàng\n[giỏ có hàng, đã đăng nhập]
P --> D
G --> C : Checkout
M ..> A : Đặt hàng\n[chưa đăng nhập]
G ..> A : Checkout\n[chưa đăng nhập]
C --> T
T --> X : lưu đơn thành công

@enduml
