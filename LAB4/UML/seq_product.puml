@startuml
skinparam backgroundColor white
skinparam monochrome true
skinparam shadowing false
skinparam defaultFontName Times New Roman
skinparam defaultFontSize 20
skinparam dpi 180
skinparam classAttributeIconSize 0
skinparam roundcorner 0
skinparam packageStyle rectangle
skinparam classBackgroundColor white
skinparam usecaseBackgroundColor white
skinparam nodesep 75
skinparam ranksep 85
skinparam ArrowFontSize 15
skinparam sequenceMessageAlign center
skinparam responseMessageBelowArrow true
hide circle
hide empty members

actor "Khách truy cập" as K
boundary FrmSanPham as F
control ProductService as S
control "ProductCatalog\nAdapter" as A
entity SanPham as P
boundary "FrmChiTiet\nSanPham" as D
K -> F : chọn nhóm / tìm từ khóa
activate F
F -> S : Search(group, keyword)
activate S
S -> A : Search(group, keyword)
activate A
A -> A : đọc catalog qua SqlRepository.Open()
A --> S : List<SanPham>
deactivate A
S --> F : danh sách
deactivate S
F --> K : hiển thị danh sách
deactivate F
K -> F : chọn xem chi tiết
activate F
F -> D : new FrmChiTietSanPham(app, code)
activate D
D -> S : Get(code)
activate S
S -> A : Get(code)
activate A
A -> A : đọc sản phẩm, danh sách ảnh
A --> S : SanPham
deactivate A
S --> D : SanPham
deactivate S
D -> P : đọc thuộc tính và HinhAnh
activate P
P --> D : thông tin chi tiết
deactivate P
D --> K : hiển thị thông tin, ảnh
deactivate D
deactivate F

@enduml